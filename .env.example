# Server
PORT=3000

# Cloud SQL (Postgres + PostGIS)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
# Local dev: run `cloud-sql-proxy <project:region:instance>` and connect via TCP
DB_HOST=127.0.0.1
DB_PORT=5432
# Cloud Run: set INSTANCE_CONNECTION_NAME instead of DB_HOST to use the /cloudsql unix socket
# INSTANCE_CONNECTION_NAME=project:region:instance

# NextBillion.ai
NEXTBILLION_API_KEY=your-nextbillion-api-key
